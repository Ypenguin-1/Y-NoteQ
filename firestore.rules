// ============================================================
// Y-NoteQ Firestore セキュリティルール(Phase 2まで: 認証・招待コード・フォルダー/単語帳/単語)
// Firebaseコンソール > Firestore Database > ルール に、このファイルの中身を
// 【全文コピーして上書き】し、右上の「公開」を押してください。
// (このファイルを更新するたびに、同じ手順で公開し直す必要があります)
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザープロフィール: 本人のみ読み書き可能
    match /users/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // フォルダー / 単語帳 / 単語(users/{uid}/folders/{fid}/wordbooks/{bid}/words/{wid})
    // 本人のデータ配下はすべて本人のみ読み書き可能(Phase 2)
    match /users/{uid}/folders/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // テスト実施記録(users/{uid}/testResults/{resultId}) : 本人のみ読み書き可能(アカウントタブで使用予定)
    match /users/{uid}/testResults/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 共有単語帳(sharedWordbooks/{id}, サブコレクション words) : 仕様追加2026/09/12 No.4
    // ・読み取りはログイン済みユーザーなら誰でも可能(共有一覧の閲覧・インストール用)
    // ・作成/更新/削除は投稿者本人のみ。official(公式)フラグはFirebaseコンソールから手動で付与する想定のため、
    //   アプリ側からの書き込みで official を true にはできないようにする
    match /sharedWordbooks/{sharedId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.official == false;
      allow update, delete: if request.auth != null && resource.data.authorUid == request.auth.uid;

      match /words/{wordId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/sharedWordbooks/$(sharedId)).data.authorUid == request.auth.uid;
      }
    }

    // 招待コード
    // ・get(1件取得)は未ログインでも許可(新規登録の最初のステップで照合するため)
    // ・list(一覧取得)は禁止し、コードの総当たり列挙を防止
    // ・使用済みにする更新は、サインアップ直後の本人(認証済み)のみ、
    //   かつ「まだ使われていないコード」に対してのみ許可する
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow update: if request.auth != null
                    && resource.data.used != true
                    && request.resource.data.usedBy == request.auth.uid;
      allow create, delete: if false; // コードの発行/削除は管理者がFirebaseコンソールから行う想定
    }

    // 上記以外は全て拒否(未設計のコレクションへの誤アクセスを防止)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
